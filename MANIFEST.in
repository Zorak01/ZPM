include LICENSE
recursive-include docs *.md
recursive-include tests *.py
recursive-include tools *.py *.ps1
recursive-include benchmarks/mesh-core/reference *.cs *.csproj *.json *.Config
recursive-include benchmarks/mesh-core/fixtures *.json *.zms
recursive-include benchmarks/mesh-core/results *.json *.csv *.cs *.svg
include benchmarks/mesh-core/README.md benchmarks/mesh-core/run.py
recursive-include runtime *.cs
recursive-include benchmarks/mesh-read/reference *.cs *.csproj
recursive-include benchmarks/mesh-read/results *.json *.csv
recursive-include benchmarks/mesh-read/tools *.py
include benchmarks/mesh-read/README.md benchmarks/mesh-read/run.py benchmarks/mesh-read/build_with_csc.py
global-exclude *.py[cod]
prune benchmarks/mesh-core/reference/bin
prune benchmarks/mesh-core/reference/obj
prune benchmarks/mesh-read/reference/bin
prune benchmarks/mesh-read/reference/obj
